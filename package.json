    "paint": "node painter/generate.mjs",
    "shoot": "node loop/shoot.mjs",
    "judge": "node judge/judge.mjs",
    "build": "node web/build.mjs",
    "serve": "node web/server.mjs"
  },
  "dependencies": {
    "p5": "2.3.4",
    "p5.brush": "2.2.3",
    "playwright": "1.64.1",
    "pngjs": "^7.0.0"
  }
}
